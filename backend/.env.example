# ---- Core data services ----
# Docker host port. If changed, use the same port in DATABASE_URL.
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://frameseek:frameseek_dev@localhost:5432/frameseek
REDIS_URL=redis://localhost:6379

# ---- Auth (Google web OAuth + cookie sessions) ----
# Generate: openssl rand -hex 32   (startup refuses the placeholder value)
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ---- Azure Blob Storage (managed identity in Azure; connection string for local/Azurite) ----
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONNECTION_STRING=

# ---- Azure AI ----
AZURE_VISION_ENDPOINT=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_WHISPER_DEPLOYMENT=whisper

# ---- Service Bus (leave empty locally to run jobs inline) ----
SERVICE_BUS_FQDN=
SERVICE_BUS_QUEUE=video-processing

# ---- Billing (Stripe) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_PRO_MAX_MONTHLY=
STRIPE_PRICE_PRO_MAX_ANNUAL=

# ---- App ----
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080
MAX_UPLOAD_SIZE_MB=500
STORAGE_BASE_PATH=./storage
DEBUG=true

# ---- Optional: load secrets from Key Vault via managed identity ----
AZURE_KEY_VAULT_URI=
